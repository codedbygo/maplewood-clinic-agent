# Copy to .env and fill in. .env is git-ignored.

# Provider: openrouter (default, free models) or anthropic
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Best free tool-calling model found on OpenRouter (2026-10-22), with fallbacks if it is busy
AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AGENT_FALLBACK_MODELS=minimax/minimax-m3.1-flash:free,nvidia/nemotron-3-super-120b-a12b:free
# low | medium | high (reasoning effort)
AGENT_EFFORT=medium
# Seconds between OpenRouter requests (free tier is limited per minute)
OPENROUTER_MIN_INTERVAL=3.2

# Anthropic instead: LLM_PROVIDER=anthropic, AGENT_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
